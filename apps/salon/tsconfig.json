{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "noImplicitAny": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/index.css": [
        "./src/index.css"
      ],
      "@/ops/*": [
        "./src/features/*"
      ],
      "@/ops": [
        "./src/features"
      ],
      "@/application/facades": [
        "./src/lib/facades/index"
      ],
      "@/application/facades/*": [
        "./src/lib/facades/*"
      ],
      "@/application/services/*": [
        "./src/lib/services/*"
      ],
      "@/application/tenant": [
        "./src/lib/tenant"
      ],
      "@/application/tenant/*": [
        "./src/lib/tenant/*"
      ],
      "@/domains/*": [
        "./src/lib/domains/*"
      ],
      "@/infrastructure/notifications/*": [
        "./src/lib/notifications/*"
      ],
      "@/infrastructure/supabase/server": [
        "./src/lib/supabase/server"
      ]
    },
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
